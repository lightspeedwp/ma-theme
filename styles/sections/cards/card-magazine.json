{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Card Magazine",
  "slug": "card-magazine",
  "blockTypes": [
    "core/group"
  ],
  "description": "Magazine card shell with white background, no border. Image has rounded corners, shadow, and scales up on hover.",
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "none"
    },
    "css": "& .wp-block-post-featured-image{overflow:hidden;border-radius:var(--wp--preset--border-radius--200);box-shadow:var(--wp--preset--shadow--200);transition:box-shadow 0.3s ease;} & .wp-block-post-featured-image img{transition:transform 0.3s ease;} & .wp-block-post-featured-image:hover{box-shadow:var(--wp--preset--shadow--300);} & .wp-block-post-featured-image:hover img{transform:scale(1.05);}",
    "blocks": {
      "core/post-title": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "600",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            ":hover": {
              "color": {
                "text": "var:preset|color|cta-500"
              }
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|neutral-700"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body",
          "lineHeight": "1.5"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|neutral-700"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|body"
        }
      }
    }
  }
}