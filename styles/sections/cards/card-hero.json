{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Card Hero",
	"slug": "card-hero",
	"blockTypes": [
		"core/group"
	],
	"description": "Horizontal hero card with square featured image, post-type label, title, and meta. Neutral-100 background at rest, white on hover.",
	"styles": {
		"color": {
			"background": "var:preset|color|neutral-100",
			"text": "var:preset|color|contrast"
		},
		"border": {
			"radius": "var(--wp--preset--border-radius--300)"
		},
		"shadow": "var:preset|shadow|200",
		"spacing": {
			"blockGap": "none"
		},
		"css": "&{overflow:hidden;transition:background-color 0.2s ease,box-shadow 0.2s ease;} &:hover{background-color:var(--wp--preset--color--base);box-shadow:var(--wp--preset--shadow--300);} & .wp-block-post-featured-image{width:100px;min-width:100px;height:100px;overflow:hidden;border-radius:var(--wp--preset--border-radius--200);flex-shrink:0;} & .wp-block-post-featured-image img{object-fit:cover;width:100%;height:100%;}",
		"blocks": {
			"core/post-title": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|cta-500"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|neutral-700"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body"
				}
			}
		}
	}
}